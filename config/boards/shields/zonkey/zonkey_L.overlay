#include "zonkey.dtsi"

/* * ボード側の pinctrl-0 エラーを回避するため、
 * ボード標準の i2c0_default などをそのまま参照させるか、
 * 独自に定義して明示的に割り当てる必要があります。
 */

&pinctrl {
    /* 左手では使わないが、文法上必要な定義 */
    i2c0_default_alt: i2c0_default_alt {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
                    <NRF_PSEL(TWIM_SCL, 0, 5)>;
        };
    };

    i2c0_sleep_alt: i2c0_sleep_alt {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 4)>,
                    <NRF_PSEL(TWIM_SCL, 0, 5)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    /* statusをdisabledにしても、pinctrlは「存在」していなければならない */
    status = "disabled";
    pinctrl-0 = <&i2c0_default_alt>;
    pinctrl-1 = <&i2c0_sleep_alt>;
    pinctrl-names = "default", "sleep";
};

&kscan0 {
    col-gpios
        = <&xiao_d 5 GPIO_ACTIVE_HIGH>
        , <&xiao_d 4 GPIO_ACTIVE_HIGH>
        , <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>
        , <&xiao_d 7 GPIO_ACTIVE_HIGH>
        ;
};
