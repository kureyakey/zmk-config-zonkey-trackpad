#include "zonkey.dtsi"

&default_transform {
    col-offset = <6>;
};

&kscan {
    col-gpios
        = <&xiao_d 7 GPIO_ACTIVE_HIGH>
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>
        , <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 4 GPIO_ACTIVE_HIGH>
        , <&xiao_d 5 GPIO_ACTIVE_HIGH>
        ;
};

// zonkey_R.overlay の該当箇所

&i2c0 {
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    pinnacle: pinnacle@2a {
        /* cirque,pinnacle でエラーが出る場合は、
           モジュールが定義している正しい compatible 名にする必要があります。
           多くの外部モジュールでは "cirque,pinnacle" ですが、
           エラーが続く場合は "pinnacle" に書き換えてください。 */
        compatible = "cirque,pinnacle";
        reg = <0x2a>;
        status = "okay";
        dr-gpios = <&xiao_d 0 (GPIO_ACTIVE_HIGH)>;
        
        /* このモジュールで必須となることが多い設定項目 */
        sleep-gpios = <&xiao_d 1 GPIO_ACTIVE_LOW>; // 未使用なら削除可
    };
};
